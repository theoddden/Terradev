{
  "query": "\n        mutation CreatePod($input: PodFindAndDeployOnDemandInput!) {\n            podFindAndDeployOnDemand(input: $input) {\n                id\n                name\n                gpuCount\n                machineId\n                desiredStatus\n            }\n        }\n        ",
  "variables": {
    "input": {
      "name": "terradev-rtx4090-<TIMESTAMP>",
      "imageName": "runpod/pytorch:2.2.0-py3.10-cuda12.1.1-devel-ubuntu22.04",
      "gpuTypeId": "rtx4090",
      "cloudType": "COMMUNITY",
      "containerDiskInGb": 40,
      "minMemoryInGb": 24,
      "minVcpuCount": 4,
      "env": [
        {
          "key": "TERRADEV_MANAGED",
          "value": "true"
        },
        {
          "key": "GPU_TYPE",
          "value": "RTX4090"
        }
      ],
      "ports": "22/tcp,8888/http",
      "gpuCount": 1,
      "startSsh": true,
      "supportPublicIp": true
    }
  }
}