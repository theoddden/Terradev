# Colang 2.x — PII masking
define flow mask sensitive data
  """Mask PII in user input before processing."""
  $sanitized = execute mask_pii(text=$user_message)
  $user_message = $sanitized

define flow mask sensitive data on output
  """Mask PII in bot output before returning."""
  $sanitized = execute mask_pii(text=$bot_message)
  $bot_message = $sanitized
